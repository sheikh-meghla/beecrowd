{"name":"Stutterer Digitizer","group":"beecrowd - Strings","url":"https://judge.beecrowd.com/en/problems/view/2815","interactive":false,"memoryLimit":1024,"timeLimit":1000,"tests":[{"input":"Juca comprou fafarinha na memercearia e papagou 4 reais o quilo. A mamae de Juca pediu para ele comprar mamais 2 quilos.\n","output":"Juca comprou farinha na mercearia e pagou 4 reais o quilo. A mae de Juca pediu para ele comprar mais 2 quilos.\n","id":1790087105986},{"id":1790087105987,"input":"O papassarinho vovoou para bem longe.\n","output":"O passarinho voou para bem longe.\n"}],"testType":"single","input":{"type":"stdin"},"output":{"type":"stdout"},"languages":{"java":{"mainClass":"Main","taskClass":"StuttererDigitizer"}},"batch":{"id":"325d1e14-eee4-4163-b27c-c2c21a5f642e","size":1},"srcPath":"c:\\Users\\sheik\\meghla\\beecrowd\\Stutterer_Digitizer.cpp"}